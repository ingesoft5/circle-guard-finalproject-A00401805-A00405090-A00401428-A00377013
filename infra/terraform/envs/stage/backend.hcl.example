# CG-DOC: Copy to backend.hcl on the on-prem host only; never commit real credentials.
bucket                      = "circleguard-tfstate"
key                         = "platform/stage/terraform.tfstate"
region                      = "us-east-1"
endpoints = {
  s3       = "http://127.0.0.1:9002"
  dynamodb = "http://127.0.0.1:8000"
}
dynamodb_table              = "circleguard-tf-lock"
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
