# CG-DOC: Template for FUTURE roots that store their state in this backend.
# Copy to <root>/backend.hcl on the on-prem host and run:
#   terraform init -backend-config=backend.hcl
# Credentials are not stored here: export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# from deploy/compose/tools/.env.onpremise (TF_STATE_MINIO_USER / TF_STATE_MINIO_PASSWORD).

bucket                      = "circleguard-tfstate"
key                         = "onpremise/<env>/terraform.tfstate"
region                      = "us-east-1"
dynamodb_table              = "circleguard-tf-lock"
endpoints = {
  s3       = "http://127.0.0.1:9002"
  dynamodb = "http://127.0.0.1:8000"
}
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
