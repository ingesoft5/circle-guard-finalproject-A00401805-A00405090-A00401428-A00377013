# CG-DOC: Nginx ingress template that exposes the dev gateway as the application entry point.
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://${DEV_PRIVATE_IP}:8087;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
