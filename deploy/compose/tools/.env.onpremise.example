# Template for .env.onpremise. bootstrap-onpremise.sh generates the real file:
# it replaces __GENERATE__ with a random secret and __HOST_IP__ with the ZeroTier IP,
# and asks for the GitHub user and token. Never commit the real file to the repository.
# Note: GITHUB_WEBHOOK_SECRET is NOT generated randomly: it must match the GitHub
# webhook secret exactly (id 709307452). See docs/infra/migracion-onpremise.md section 3.6.
# Note: SONAR_TOKEN is not generated either: it is an API token created in SonarQube. See 3.6.
JENKINS_ADMIN_PASSWORD=__GENERATE__
PROFESSOR_PASSWORD=__GENERATE__
PROFESSOR_SONAR_PASSWORD=__GENERATE__
PROFESSOR_NEXUS_PASSWORD=__GENERATE__
GITHUB_USER=__GITHUB_USER__
GITHUB_TOKEN=__GITHUB_TOKEN__
GITHUB_OWNER=ingesoft5
GITHUB_REPO=circle-guard-finalproject-A00401805-A00405090-A00401428-A00377013
GITHUB_REPO_URL=https://github.com/ingesoft5/circle-guard-finalproject-A00401805-A00405090-A00401428-A00377013.git
GITHUB_WEBHOOK_SECRET=__GITHUB_WEBHOOK_SECRET__
SONAR_DB_PASSWORD=__GENERATE__
# A fresh SonarQube starts with admin/admin; this password only applies if changed
# in the UI. It is not a scanner API token.
SONAR_ADMIN_PASSWORD=__GENERATE__
# SonarQube API token for the scanner and quality gate. It is NOT random:
# create it in SonarQube (My Account > Security) or via the API:
#   curl -u admin:admin -X POST http://localhost:9000/api/user_tokens/generate \
#        --data-urlencode 'name=jenkins-ci'
SONAR_TOKEN=__SONAR_TOKEN__
NEXUS_USER=jenkins
NEXUS_PASSWORD=__GENERATE__
# Jenkins uses network_mode: host; nexus:8081 only resolves inside tools-net.
NEXUS_URL=http://localhost:8081
NEXUS_REGISTRY=__HOST_IP__:5000
TOOLS_IP=__HOST_IP__
TOOLS_PRIVATE_IP=__HOST_IP__
DEV_PRIVATE_IP=__HOST_IP__
STAGE_PRIVATE_IP=__HOST_IP__
PROD_PRIVATE_IP=__HOST_IP__
# Jenkins uses network_mode: host; localhost reaches the published ports.
SONAR_HOST_URL=http://localhost:9000
JENKINS_URL=http://__HOST_IP__:8080/
LIBRARY_BRANCH=main
# Automatic failure/success notifications (E1.5, E2.3, P1.5, P2.5).
# Notifications are sent through every configured channel: Slack, Discord and email.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_RECIPIENTS=santiago04182005@gmail.com,alejocarlsen@gmail.com,faiberpiedrahita@gmail.com,daniela.castanomoreno@u.icesi.edu.co
# SMTP for the email notification channel (Office365 STARTTLS on port 587).
# Set SMTP_PASSWORD locally in .env; never commit a real password.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=daniela.castanomoreno@u.icesi.edu.co
SMTP_PASSWORD=
MAIL_FROM=daniela.castanomoreno@u.icesi.edu.co
SMEE_URL=https://smee.io/nk4nvlnyB0u6Fqnn
# The trailing double slash is intentional: smee-client strips ONE slash and Jenkins'
# Stapler returns 302 without it, downgrading the POST to GET (405 Method POST required).
SMEE_TARGET=http://localhost:8080/github-webhook//

# --- IaC on-prem (HU-INFRA-06) ---
# CG-DOC: MinIO acts as S3 and DynamoDB Local as the lock table for Terraform.
# CG-DOC: Real values are generated on the server; this file is a template only.
TF_STATE_MINIO_USER=__GENERATE__
TF_STATE_MINIO_PASSWORD=__GENERATE__
TF_STATE_BUCKET=circleguard-tfstate
TF_LOCK_TABLE=circleguard-tf-lock
TF_MINIO_ENDPOINT=http://127.0.0.1:9002
TF_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=us-east-1
# CG-DOC: Grafana admin password consumed by the Terraform observability module
# through the Jenkins credential `terraform-grafana-password`.
TF_GRAFANA_ADMIN_PASSWORD=__GENERATE__
