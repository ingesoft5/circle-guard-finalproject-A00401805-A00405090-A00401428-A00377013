# Plantilla para .env.onpremise. El bootstrap-onpremise.sh genera el archivo real:
# reemplaza __GENERATE__ por un secreto aleatorio, __HOST_IP__ por la IP de ZeroTier
# y pide el usuario y token de GitHub. Nunca subir el archivo real al repositorio.
# Ojo: GITHUB_WEBHOOK_SECRET NO se genera aleatoriamente: debe coincidir exactamente
# con el secreto del webhook de GitHub (id 709307452). Ver docs/infra/migracion-onpremise.md 3.6.
# Ojo: SONAR_TOKEN tampoco se genera: es un token de API creado en SonarQube. Ver 3.6.
JENKINS_ADMIN_PASSWORD=__GENERATE__
PROFESSOR_PASSWORD=__GENERATE__
PROFESSOR_SONAR_PASSWORD=__GENERATE__
PROFESSOR_NEXUS_PASSWORD=__GENERATE__
GITHUB_USER=__GITHUB_USER__
GITHUB_TOKEN=__GITHUB_TOKEN__
GITHUB_OWNER=ingesoft5
GITHUB_REPO=circle-guard-finalproject-A00401805-A00405090-A00401428-A00377013
GITHUB_REPO_URL=https://github.com/ingesoft5/circle-guard-finalproject-A00401805-A00405090-A00401428-A00377013.git
GITHUB_WEBHOOK_SECRET=__GITHUB_WEBHOOK_SECRET__
SONAR_DB_PASSWORD=__GENERATE__
# SonarQube fresco arranca con admin/admin; esta clave solo vale si se cambia en la
# interfaz. No sirve como token de API del scanner.
SONAR_ADMIN_PASSWORD=__GENERATE__
# Token de API de SonarQube para el scanner y el quality gate. NO es aleatorio:
# créalo en SonarQube (My Account > Security) o por API:
#   curl -u admin:admin -X POST http://localhost:9000/api/user_tokens/generate \
#        --data-urlencode 'name=jenkins-ci'
SONAR_TOKEN=__SONAR_TOKEN__
NEXUS_USER=jenkins
NEXUS_PASSWORD=__GENERATE__
# Jenkins va en network_mode: host; nexus:8081 solo resuelve dentro de tools-net.
NEXUS_URL=http://localhost:8081
NEXUS_REGISTRY=__HOST_IP__:5000
TOOLS_IP=__HOST_IP__
TOOLS_PRIVATE_IP=__HOST_IP__
DEV_PRIVATE_IP=__HOST_IP__
STAGE_PRIVATE_IP=__HOST_IP__
PROD_PRIVATE_IP=__HOST_IP__
# Jenkins va en network_mode: host; localhost llega a los puertos publicados.
SONAR_HOST_URL=http://localhost:9000
JENKINS_URL=http://__HOST_IP__:8080/
LIBRARY_BRANCH=main
SLACK_WEBHOOK_URL=
SMEE_URL=https://smee.io/nk4nvlnyB0u6Fqnn
SMEE_TARGET=http://localhost:8080/github-webhook/
