# CG-DOC: Environment variable template for the dev stack.
TAG=1.0.0-local
NEXUS_REGISTRY=127.0.0.1:5000
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
OPENLDAP_ADMIN_PASSWORD=change-me
QR_SECRET=change-me
JWT_SECRET=change-me
VAULT_SECRET=change-me-32-chars-long-1234567890
VAULT_SALT=change-me
VAULT_HASH_SALT=change-me
ENV_HOST_IP=127.0.0.1

# Object storage (MinIO). Valores de ejemplo: reemplazar en .env (no versionado)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-change-me
AWS_S3_BUCKET=circleguard-files

# notification-service: canales de envío. Con AC_MOCK_SID / MOCK_TOKEN el servicio
# no contacta Twilio ni Gotify y registra el despacho como MOCK (audit SUCCESS).
# Reemplazar por credenciales reales en el .env de cada ambiente, nunca en el repo.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=change-me
SMTP_PASSWORD=change-me
TWILIO_ACCOUNT_SID=AC_MOCK_SID
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=+15550000000
PUSH_GOTIFY_URL=http://gotify:80
PUSH_GOTIFY_TOKEN=MOCK_TOKEN
