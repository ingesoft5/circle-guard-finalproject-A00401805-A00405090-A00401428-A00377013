{
  "title": "CircleGuard Dashboard Observability",
  "uid": "circleguard-dashboard-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "circleguard",
    "dashboard"
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": null,
        "query": "label_values(up{app=\"dashboard\"}, namespace)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "cg-dev|cg-stage|cg-prod",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Dashboard scrape availability",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "up{app=\"dashboard\",namespace=~\"$namespace\"}",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_server_requests_seconds_count{app=\"dashboard\",namespace=~\"$namespace\",uri!~\"/actuator.*\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx requests per second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_server_requests_seconds_count{app=\"dashboard\",namespace=~\"$namespace\",status=~\"5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Mean HTTP latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_server_requests_seconds_sum{app=\"dashboard\",namespace=~\"$namespace\",uri!~\"/actuator.*\"}[5m])) / sum by (pod) (rate(http_server_requests_seconds_count{app=\"dashboard\",namespace=~\"$namespace\",uri!~\"/actuator.*\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Promotion calls per second by outcome",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(circleguard_dashboard_promotion_calls_total{app=\"dashboard\",namespace=~\"$namespace\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Promotion call p95 latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(circleguard_dashboard_promotion_call_duration_seconds_bucket{app=\"dashboard\",namespace=~\"$namespace\"}[5m])))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Dashboard centralized logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "{app=\"dashboard\",namespace=~\"$namespace\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ]
}
