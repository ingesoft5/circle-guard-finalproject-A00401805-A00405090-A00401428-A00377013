# CG-DOC: Template for the per-environment secrets. Copy to secrets.env and replace every value.
# JWT_SECRET must be at least 32 bytes or promotion-service fails with WeakKeyException.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-bytes
QR_SECRET=change-me
VAULT_SECRET=change-me
VAULT_SALT=change-me
VAULT_HASH_SALT=change-me
NEO4J_PASSWORD=change-me
NEO4J_AUTH=neo4j/change-me
OPENLDAP_ADMIN_PASSWORD=change-me
