#!/bin/sh
# .githooks/pre-push

# Obtener el nombre de la rama actual en la que estamos trabajando
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# =====================================================================
# 1. BLOQUEAR PUSH DIRECTO A main
# =====================================================================
while read local_ref local_sha remote_ref remote_sha
do
    # Verificamos si el push va dirigido a main
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "======================================================"
        echo "❌ ERROR: Push directo a la rama protegida detectado."
        echo "======================================================"
        echo "En GitHub Flow, está prohibido hacer push directo a 'main'."
        echo "Por favor, crea una rama (HU-...) y abre un Pull Request."
        echo "======================================================"
        exit 1
    fi
done

# =====================================================================
# 2. VALIDAR EL FORMATO DEL NOMBRE DE LA RAMA
# =====================================================================
# Formatos aceptados:
#   [<tipo>/]HU-<MICROSERVICIO>-<numero>-<descripcion>  (historias de usuario)
#   fix/<descripcion>                                  (correcciones sin HU)
# Ejemplos: feat/HU-GATEWAY-01-configurar-servidores, fix/coverage-and-registry-login
# Nota: Si estás en main (por ejemplo, para traer cambios), no validamos el nombre.
if [ "$CURRENT_BRANCH" != "main" ]; then
    HU_FORMAT="^((feat|fix|docs|ci|chore|test|refactor|build|perf|style)/)?HU-[A-Z]+-[0-9]+(-[a-z0-9-]+)?$"
    FIX_FORMAT="^fix/[a-z0-9][a-z0-9-]*$"
    if ! echo "$CURRENT_BRANCH" | grep -qE "($HU_FORMAT|$FIX_FORMAT)"; then
        echo "======================================================"
        echo "⚠️ ADVERTENCIA: El nombre de tu rama no sigue la convención."
        echo "======================================================"
        echo "Tu rama actual es: $CURRENT_BRANCH"
        echo "Formatos aceptados:"
        echo "  [<tipo>/]HU-<MICROSERVICIO>-<numero>-<descripcion>"
        echo "  fix/<descripcion> (correcciones sin HU)"
        echo "Ejemplos: feat/HU-GATEWAY-01-configurar-servidores, fix/coverage-and-registry-login"
        echo ""
        echo "El push se cancelará en 5 segundos. Presiona Ctrl+C para abortar y renombrar tu rama."
        echo "======================================================"
        sleep 5
        exit 1
    fi
fi

# Si todo está bien, el script termina con éxito y permite el push
exit 0
