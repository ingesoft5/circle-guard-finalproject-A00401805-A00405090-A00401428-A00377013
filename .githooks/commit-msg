#!/bin/sh
# .git/hooks/commit-msg (o .githooks/commit-msg si usas la configuración compartida)

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

# Expresión regular:
# 1. Tipos permitidos
# 2. Alcance opcional (ej. (auth))
# 3. ! opcional para breaking changes
# 4. : y espacio
# 5. Descripción obligatoria en inglés
REGEX="^(feat|fix|docs|ci|chore|test|refactor|build|perf|style)(\([a-z-]+\))?!?: .+$"

if ! echo "$COMMIT_MSG" | grep -qE "$REGEX"; then
    echo "======================================================"
    echo "❌ ERROR: El mensaje de commit no sigue el estándar."
    echo "======================================================"
    echo "Estructura requerida: <tipo>(<alcance>): <descripción>"
    echo "Ejemplo: feat(auth): add token validation"
    echo ""
    echo "Tipos permitidos: feat, fix, docs, ci, chore, test, refactor, build, perf, style"
    echo "El mensaje debe estar en inglés."
    echo "======================================================"
    exit 1
fi
