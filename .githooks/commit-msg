#!/bin/sh
# .git/hooks/commit-msg (o .githooks/commit-msg si usas la configuración compartida)

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

# Expresión regular: 
# 1. Tipos permitidos
# 2. Alcance opcional (ej. (auth))
# 3. ! opcional para breaking changes
# 4. : y espacio
# 5. Descripción obligatoria
# 6. [CG-XX] obligatorio al final
REGEX="^(feat|fix|docs|ci|chore|test|refactor|build|perf|style)(\([a-z-]+\))?!?: .+ \[CG-[0-9]+\]$"

if ! echo "$COMMIT_MSG" | grep -qE "$REGEX"; then
    echo "======================================================"
    echo "❌ ERROR: El mensaje de commit no sigue el estándar."
    echo "======================================================"
    echo "Estructura requerida: <tipo>(<alcance>): <descripción> [ID-JIRA]"
    echo "Ejemplo: feat(auth): agrega validacion de token [CG-12]"
    echo ""
    echo "Tipos permitidos: feat, fix, docs, ci, chore, test, refactor, build, perf, style"
    echo "El ID de Jira (ej. [CG-12]) es OBLIGATORIO al final."
    echo "======================================================"
    exit 1
fi
