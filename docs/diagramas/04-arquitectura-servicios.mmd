        FORM["Form :8086<br/>PostgreSQL + Kafka + outbox"]
        PROM["Promotion :8088<br/>PostgreSQL + Neo4j + Kafka + Redis"]
        ID["Identity :8083<br/>PostgreSQL"]
        NOTIF["Notification :8082<br/>Kafka + SMTP/SMS"]
        FILE["File :8085<br/>S3-compatible"]
        DASH["Dashboard :8084<br/>Neo4j / PostgreSQL"]
    end

    subgraph MW["Middleware compartido por ambiente"]
        PG[("PostgreSQL")]
        LDAP[("OpenLDAP :389")]
        K[("Kafka :9092")]
        R[("Redis :6379")]
