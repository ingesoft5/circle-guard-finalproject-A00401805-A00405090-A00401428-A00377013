%% CG-DOC: Patrón de configuración (E2.4) — External Configuration + Feature Toggle.
%% Evidencia: perfiles Spring + ConfigMaps por ambiente en deploy/k8s/overlays/*.
flowchart TB
    subgraph SRC["Fuentes externas de configuración"]
      CM["ConfigMap por ambiente<br/>deploy/k8s/overlays/dev|stage|prod"]
      SEC["Secret fuera del repo<br/>credenciales inyectadas"]
      ENV["Variables de entorno<br/>FORM_ENVIRONMENT = metadata.namespace"]
    end

    subgraph APP["Microservicio Spring Boot"]
      PR["Perfiles Spring<br/>dev · stage · prod"]
      FT["Feature Toggle<br/>banderas por ambiente"]
      SVC["Servicio<br/>@ConfigurationProperties"]
    end

    CM --> PR
    SEC --> SVC
    ENV --> PR
    PR --> FT
    FT --> SVC
    SVC --> OUT["Comportamiento adaptable<br/>sin reconstruir la imagen"]

    K["Kustomize overlay"] -. genera .-> CM
    J["Jenkins kubectl apply -k"] -. despliega .-> K

    classDef cfg fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    class CM,SEC,ENV,PR,FT cfg;
