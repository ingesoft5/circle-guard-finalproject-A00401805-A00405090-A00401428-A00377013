    subgraph OBS["Observabilidad del patrón"]
      M["Micrometer<br/>resilience4j_circuitbreaker_state"]
      A["Alerta AuthIdentityCircuitBreakerOpen<br/>severity critical"]
    end

    ID -. métricas .-> M
    CB -. métricas .-> M
    M --> A

    classDef ok fill:#d7f7d7,stroke:#2e7d32,color:#1b5e20;
    classDef warn fill:#fff3cd,stroke:#b8860b,color:#7a5b00;
    class ID,FB ok;
    class CB,A warn;
