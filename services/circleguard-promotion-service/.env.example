# Environment template for circleguard-promotion-service.
# Copy to .env (ignored by Git) and fill in real values; never commit secrets.
#
# Relational database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/circleguard_promotion
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=change-me

# Neo4j graph
SPRING_NEO4J_URI=bolt://localhost:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=change-me

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Shared JWT secret with auth-service
JWT_SECRET=change-me
JWT_EXPIRATION=3600000

# HTTP
SERVER_PORT=8088
