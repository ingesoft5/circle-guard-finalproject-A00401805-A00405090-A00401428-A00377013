# CG-DOC: Git ignore rules for generated files, secrets, and local state.
# Gradle
.gradle/
build/
!**/src/**/build/
**/build/

# Java
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven
target/
**/target/

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Node/Expo (Handled in mobile/ but good to have here too)
node_modules/
.expo/
dist/
web-build/
mobile/coverage/

# Docker Local Data
*_data/
pgdata/
neo4jdata/

# CircleGuard infrastructure
infra/state/
*.pem
*.key
.env
.env.*
*.env
!.env.example
!.env.*.example

# Kubernetes overlay secrets
deploy/k8s/overlays/*/secrets.env

# File service local storage directory
services/circleguard-file-service/uploads/
uploads/
